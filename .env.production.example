DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=PUBLIC_IP,localhost,127.0.0.1
DJANGO_TIME_ZONE=America/Bogota

DATABASE_URL=mysql://mcp_user:replace-db-password@mariadb:3306/mcp_db
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=mcp_db
DB_USER=mcp_user
DB_PASSWORD=replace-db-password
DB_ROOT_PASSWORD=replace-root-password
MARIADB_DATABASE=mcp_db
MARIADB_USER=mcp_user
MARIADB_PASSWORD=replace-db-password
MARIADB_ROOT_PASSWORD=replace-root-password

API_KEY=replace-api-key
PROCESS_JOBS_ASYNC=1
STUB_PROVIDERS=0
OCR_PROVIDER=ollama
LLM_PROVIDER=ollama_text

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_URL=http://host.docker.internal:11434/api/generate
OLLAMA_TAGS_URL=http://host.docker.internal:11434/api/tags
OLLAMA_MODEL=gemma3:1b-it-qat
OLLAMA_VISION_MODEL=gemma4:e2b
OLLAMA_TIMEOUT=320

CORS_ALLOWED_ORIGINS=http://PUBLIC_IP
CSRF_TRUSTED_ORIGINS=http://PUBLIC_IP
MCP_ENABLE_MUTATIONS=0
MCP_ALLOWED_UPLOAD_ROOTS=

ALLOW_OPEN_API_FOR_DEV=0
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=0
LOG_LEVEL=INFO
