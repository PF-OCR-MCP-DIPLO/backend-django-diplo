DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-for-your-local-env
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=America/Bogota

# =====================================================
# CONFIGURACIÓN DE BASE DE DATOS - MARIADB
# =====================================================
DATABASE_URL=mysql://mcp_user:mcp_secure_2026@localhost:3306/mcp_db
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mcp_db
DB_USER=mcp_user
DB_PASSWORD=mcp_secure_2026
DB_ROOT_PASSWORD=root_mcp_2026

LOG_LEVEL=INFO
APP_VERSION=0.1.0

API_KEY=dev
PROCESS_JOBS_ASYNC=1
# Usa 0 para extracción real. Cambia a 1 solo para demo estable determinística.
STUB_PROVIDERS=0
# Referencia histórica interna. El MVP defendible hoy usa ollama/tesseract.
OCR_PROVIDER=ollama_vision
# Referencia histórica interna. El MVP defendible hoy usa ollama/tesseract.
LLM_PROVIDER=ollama_text
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=gemma3:1b-it-qat
OLLAMA_VISION_MODEL=gemma4:e2b
OLLAMA_TIMEOUT=320

# =====================================================
# MODELOS LLM / OCR / ASSISTANT (Configurables por entorno)
# =====================================================
LLM_MODEL=gemma3:1b-it-qat
OCR_MODEL=spa
ASSISTANT_MODEL=gemma3:1b-it-qat
ASSISTANT_TEMPERATURE=0.2
ASSISTANT_NUM_PREDICT=256
OCR_TEMPERATURE=0.2
OCR_NUM_PREDICT=128

LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=2

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Activa con 1 solo si realmente vas a demostrar mutaciones MCP.
MCP_ENABLE_MUTATIONS=0
